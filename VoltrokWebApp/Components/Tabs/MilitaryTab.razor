    private static string FormatMultiplier(decimal multiplier) => $"{multiplier:0.00}x";

    private IEnumerable<PlayerMilitaryProduction> GetUnitQueueOrders(MilitaryUnit unit)
        => ActiveRecruitmentOrders
            .Where(order => string.Equals(order.MilitaryUnitsCode, unit.Code.ToString(), StringComparison.OrdinalIgnoreCase))
            .OrderBy(order => order.CreatedAt);

    private static int GetRemainingQueuedQuantity(PlayerMilitaryProduction order)
        => Math.Max(0, order.Quantity - order.ProducedQuantity);

    private int GetQueuedUnitQuantity(MilitaryUnit unit)
        => GetUnitQueueOrders(unit).Sum(GetRemainingQueuedQuantity);

    private int GetCurrentUnitQuantity(MilitaryUnit unit)
        => Player?.PlayerMilitaryUnits?
            .Where(entry => string.Equals(entry.MilitaryUnitsCode, unit.Code.ToString(), StringComparison.OrdinalIgnoreCase))
            .Sum(entry => Math.Max(0, entry.Quantity)) ?? 0;

    private int GetCurrentUnitLevel(MilitaryUnit unit)
        => Math.Max(
            Player?.PlayerMilitaryUnits?
                .Where(entry => string.Equals(entry.MilitaryUnitsCode, unit.Code.ToString(), StringComparison.OrdinalIgnoreCase))
                .Select(entry => Math.Max(1, entry.Level))
                .DefaultIfEmpty(1)
                .Max() ?? 1,
            ActiveRecruitmentOrders
                .Where(order => string.Equals(order.MilitaryUnitsCode, unit.Code.ToString(), StringComparison.OrdinalIgnoreCase))
                .Select(order => Math.Max(1, order.Level))
                .DefaultIfEmpty(1)
                .Max());

    private decimal GetRecruitmentCost(MilitaryUnit unit)
        => Math.Max(0.01m, unit.GetCost(GetCurrentUnitLevel(unit)));

    private bool CanAffordRecruitment(MilitaryUnit unit)
        => (Player?.Money ?? 0m) >= GetRecruitmentCost(unit) * Math.Max(1, GetRecruitmentQuantity(unit));

    private bool CanUpgradeUnit(MilitaryUnit unit)
        => !_isRecruiting
           && GetCurrentUnitQuantity(unit) + GetQueuedUnitQuantity(unit) > 0
           && (Player?.Chips ?? 0m) >= unit.GetUpgradeCost(GetCurrentUnitLevel(unit) + 1);

    private string GetRecruitmentEta(PlayerMilitaryProduction order)
    {
        var remaining = Math.Max(0, order.Quantity - order.ProducedQuantity);
        if (remaining == 0)
        {
            return T["tabs.common.completed"];
        }

        var mu = AvailableMilitaryUnits
            .Where(q => q.Code.ToString() == order.MilitaryUnitsCode)
            .Select(q => q.GetProductionTime(Math.Max(1, order.Level)))
            .FirstOrDefault();
        var totalSeconds = Math.Max(1, (int)Math.Ceiling((remaining * mu) / Math.Max(1m, _unitProductionSpeedMultiplier)));
        return FormatDuration(totalSeconds);
    }

    private string FormatDuration(int totalSeconds)
    {
        var timeSpan = TimeSpan.FromSeconds(Math.Max(1, totalSeconds));
        if (timeSpan.TotalHours >= 1)
        {
            return string.Format(T["tabs.military.duration.hoursMinutes"], (int)timeSpan.TotalHours, timeSpan.Minutes);
        }

        if (timeSpan.TotalMinutes >= 1)
        {
            return string.Format(T["tabs.military.duration.minutesSeconds"], timeSpan.Minutes, timeSpan.Seconds);
        }

        return string.Format(T["tabs.military.duration.seconds"], timeSpan.Seconds);
    }

    private async Task RecruitUnitAsync(MilitaryUnit unit)
    {
        if (Player == null || _isRecruiting)
        {
            return;
        }

        _isRecruiting = true;
        _recruitError = null;

        try
        {
            var quantity = GetRecruitmentQuantity(unit);
            await PlayersService.CreateMilitaryProductionAsync(Player.PlayersId, unit, quantity);

            var refreshed = await PlayersService.GetPlayerForTab(Player.PlayersId, PlayerOverviewTabEnum.Military);
            if (refreshed != null)
            {
                await UpdatePlayerStateAsync(refreshed);
            }

            _recruitSuccess = T["tabs.military.success.recruitmentQueued"];
        }
        catch (Exception ex)
        {
            Serilog.Log.Error(ex, "MilitaryTab failed to recruit unit {UnitCode} for player {PlayerId}.", unit.Code, Player.PlayersId);
            _recruitError = T["tabs.military.error.recruitmentFailed"];
        }
        finally
        {
            _isRecruiting = false;
        }
    }

