    private async Task DispatchMissionAsync()
    {
        if (Player == null || !_selectedDestinationId.HasValue || _selectedUnitLevel <= 0 || _unitQuantity <= 0 || _isDispatching)
        {
            return;
        }

        _isDispatching = true;
        _dispatchError = null;
        _dispatchSuccess = null;

        try
        {
            if (SelectedUnit == null || string.IsNullOrWhiteSpace(SelectedUnit.MilitaryUnitsCode))
            {
                throw new InvalidOperationException("No military unit selected.");
            }

            await PlayerMilitaryTransportService.DispatchMissionAsync(
                Player.PlayersId,
                _selectedDestinationId.Value,
                _selectedMissionType,
                [new MilitaryDispatchSelection(SelectedUnit.MilitaryUnitsCode, _unitQuantity)]);

            var refreshed = await PlayersService.GetPlayerForTab(Player.PlayersId, PlayerOverviewTabEnum.Military);
            if (refreshed != null)
            {
                await UpdatePlayerStateAsync(refreshed);
            }

            _unitQuantity = 1;
            _dispatchSuccess = _selectedMissionType switch
            {
                nameof(PlayerMilitaryTransportMissionType.Siege) => T["tabs.military.success.siegeMissionDispatched"],
                nameof(PlayerMilitaryTransportMissionType.Attack) => T["tabs.military.success.attackMissionDispatched"],
                _ => T["tabs.military.missionDispatched"]
            };
        }
        catch (Exception ex)
        {
            Serilog.Log.Error(ex, "MilitaryTab failed to dispatch mission {MissionType} for player {PlayerId} to destination {DestinationId}.", _selectedMissionType, Player.PlayersId, _selectedDestinationId);
            _dispatchError = T["tabs.military.error.dispatchFailed"];
        }
        finally
        {
            _isDispatching = false;
        }
    }

