    private int GetDeploymentProgressPercent(PlayerMilitaryTransport transport)
    {
        var totalSeconds = (transport.EndTime - transport.StartTime).TotalSeconds;
        if (totalSeconds <= 0)
        {
            return 100;
        }

        var elapsedSeconds = (DateTime.UtcNow - transport.StartTime).TotalSeconds;
        var progress = (int)Math.Round(elapsedSeconds / totalSeconds * 100d);
        return Math.Clamp(progress, 0, 100);
    }

    private int GetTransportPower(PlayerMilitaryTransport transport)
    {
        var stacks = transport.PlayerMilitaryTransportUnits
            .Select(unit => MilitaryCombatPowerEngine.CreateStack(unit.MilitaryUnitsCode, unit.Level, unit.Quantity))
            .Where(stack => stack.HasValue)
            .Select(stack => stack!.Value);

        var includeSiegePower = string.Equals(
            transport.MissionType,
            PlayerMilitaryTransportMissionType.Siege.ToDbValue(),
            StringComparison.OrdinalIgnoreCase);

        return (int)Math.Round(
            MilitaryCombatPowerEngine.CalculateAttackerPower(stacks, includeSiegePower),
            MidpointRounding.AwayFromZero);
    }

    private int GetDefenderPower(PlayerMilitaryTransport incomingAttack)
    {
        var defenderStacks = PlayerArmyEntries
            .Select(unit => MilitaryCombatPowerEngine.CreateStack(unit.MilitaryUnitsCode, unit.Level, unit.Quantity))
            .Where(stack => stack.HasValue)
            .Select(stack => stack!.Value);

        var attackerStacks = incomingAttack.PlayerMilitaryTransportUnits
            .Select(unit => MilitaryCombatPowerEngine.CreateStack(unit.MilitaryUnitsCode, unit.Level, unit.Quantity))
            .Where(stack => stack.HasValue)
            .Select(stack => stack!.Value);

        return (int)Math.Round(
            MilitaryCombatPowerEngine.CalculateDefenderPower(defenderStacks, attackerStacks),
            MidpointRounding.AwayFromZero);
    }

    private int GetAttackerWinChancePercent(PlayerMilitaryTransport incomingAttack)
    {
        var projection = BuildIncomingBattleProjection(incomingAttack);
        if (projection == null)
        {
            return 0;
        }

        if (projection.AttackerLocalWins != projection.DefenderLocalWins)
        {
            return projection.AttackerWon ? 100 : 0;
        }

        if (projection.AttackerRemainingHp <= 0m && projection.DefenderRemainingHp <= 0m)
        {
            return 0;
        }

        if (projection.AttackerRemainingHp <= 0m)
        {
            return 0;
        }

        if (projection.DefenderRemainingHp <= 0m)
        {
            return 100;
        }

        var chance = (int)Math.Round((double)(projection.AttackerRemainingHp / (projection.AttackerRemainingHp + projection.DefenderRemainingHp) * 100m));
        return Math.Clamp(chance, 1, 99);
    }

    private BattleSimulationResult? BuildIncomingBattleProjection(PlayerMilitaryTransport incomingAttack)
    {
        var attackerUnits = incomingAttack.PlayerMilitaryTransportUnits
            .Where(unit => unit.Quantity > 0 && !string.IsNullOrWhiteSpace(unit.MilitaryUnitsCode))
            .Select(unit => new BattleSimulationUnitInput(unit.MilitaryUnitsCode, unit.Level, unit.Quantity))
            .ToList();
        if (attackerUnits.Count == 0)
        {
            return null;
        }

        var defenderUnits = PlayerArmyEntries
            .Where(unit => unit.Quantity > 0 && !string.IsNullOrWhiteSpace(unit.MilitaryUnitsCode))
            .Select(unit => new BattleSimulationUnitInput(unit.MilitaryUnitsCode, unit.Level, unit.Quantity))
            .ToList();

        var includeSiegePower = string.Equals(
            incomingAttack.MissionType,
            PlayerMilitaryTransportMissionType.Siege.ToDbValue(),
            StringComparison.OrdinalIgnoreCase);

        return BattleSimulationEngine.SimulateBattle(attackerUnits, defenderUnits, includeSiegePower);
    }

    private string GetTimeRemainingLabel(PlayerMilitaryTransport transport)
    {
        var remaining = transport.EndTime - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero)
        {
            return T["tabs.military.lessThanMinute"];
        }

        var totalMinutes = (int)Math.Ceiling(remaining.TotalMinutes);
        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;
        var parts = new List<string>();

        if (hours > 0)
        {
            parts.Add($"{hours} {PolishPlural(hours, T["tabs.military.hour.singular"], T["tabs.military.hour.paucal"], T["tabs.military.hour.plural"])}");
        }

        if (minutes > 0 || hours == 0)
        {
            parts.Add($"{minutes} {PolishPlural(minutes, T["tabs.military.minute.singular"], T["tabs.military.minute.paucal"], T["tabs.military.minute.plural"])}");
        }

        return string.Join($" {T["tabs.common.and"]} ", parts);
    }

    private static string PolishPlural(int value, string singular, string paucal, string plural)
    {
        var mod10 = value % 10;
        var mod100 = value % 100;

        if (value == 1)
        {
            return singular;
        }

        if (mod10 is >= 2 and <= 4 && (mod100 < 12 || mod100 > 14))
        {
            return paucal;
        }

        return plural;
    }

