    private void CancelDisplayTimer()
    {
        _displayCts?.Cancel();
        _displayCts?.Dispose();
        _displayCts = null;
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;
        _pollTimer?.Dispose();
        _pollTimer = null;
        _pollTask = null;
        CancelDisplayTimer();
    }

    public new void Dispose()
    {
        StopPolling();
        base.Dispose();
    }
