    private bool TryGetBattleOutcome(PlayerNotification notification, out string label, out string cssClass, out string icon)
    {
        label = string.Empty;
        cssClass = string.Empty;
        icon = string.Empty;

        if (notification.Type is not (PlayerNotificationType.BattleReportAttacker or PlayerNotificationType.BattleReportDefender))
        {
            return false;
        }

        var kind = GetResolvedNotificationKind(notification);
        var isVictory = kind.Contains("victory", StringComparison.OrdinalIgnoreCase)
            || kind.Contains("gained", StringComparison.OrdinalIgnoreCase);

        label = isVictory ? T["notifications.battleReport.title.victory"] : T["notifications.battleReport.title.defeat"];
        cssClass = isVictory ? "is-victory" : "is-defeat";
        icon = isVictory ? "solar:cup-star-bold" : "solar:danger-triangle-bold";
        return true;
    }

    private void NavigateToNotificationDestination(PlayerNotification notification)
    {
        if (AppState.MyPlayer == null)
        {
            return;
        }

        if (notification.Type == PlayerNotificationType.ChatMessageReceived)
        {
            if (TryGetDirectChatTarget(notification, out var senderPlayerId, out var senderPlayerName))
            {
                AppState.OpenChat(ChatChannel.Direct, senderPlayerId, senderPlayerName);
            }
            else
            {
                AppState.OpenChat(ChatChannel.Direct);
            }

            return;
        }

        var targetTab = notification.Type switch
        {
            PlayerNotificationType.IncomingTransport => PlayerOverviewTabEnum.Trade,
            PlayerNotificationType.IncomingAttack => PlayerOverviewTabEnum.Military,
            PlayerNotificationType.IncomingSiege => PlayerOverviewTabEnum.Military,
            PlayerNotificationType.IncomingAid => PlayerOverviewTabEnum.Military,
            PlayerNotificationType.BattleReportAttacker => PlayerOverviewTabEnum.Military,
            PlayerNotificationType.BattleReportDefender => PlayerOverviewTabEnum.Military,
            PlayerNotificationType.SiegeStarted => PlayerOverviewTabEnum.Military,
            PlayerNotificationType.SiegeFinished => PlayerOverviewTabEnum.Military,
            _ => PlayerOverviewTabEnum.Overview
        };

        AppState.SetPlayerInfo(AppState.MyPlayer.PlayersId);
        AppState.SetBuildingInfoTab(targetTab);
        if (AppState.ActiveModal != ModalTypesEnum.Player)
        {
            AppState.OpenModal(ModalTypesEnum.Player);
        }
    }

    private static bool TryGetDirectChatTarget(PlayerNotification notification, out Guid senderPlayerId, out string senderPlayerName)
    {
        senderPlayerId = Guid.Empty;
        senderPlayerName = string.Empty;

        if (string.IsNullOrWhiteSpace(notification.DataJson))
        {
            return false;
        }

        try
        {
            using var jsonDocument = JsonDocument.Parse(notification.DataJson);
            if (!jsonDocument.RootElement.TryGetProperty("senderPlayerId", out var senderPlayerIdElement))
            {
                return false;
            }

            var senderPlayerIdRaw = senderPlayerIdElement.ValueKind == JsonValueKind.String
                ? senderPlayerIdElement.GetString()
                : senderPlayerIdElement.ToString();

            if (!Guid.TryParse(senderPlayerIdRaw, out senderPlayerId))
            {
                senderPlayerId = Guid.Empty;
                return false;
            }

            if (jsonDocument.RootElement.TryGetProperty("senderPlayerName", out var senderPlayerNameElement))
            {
                var parsedName = senderPlayerNameElement.GetString();
                if (!string.IsNullOrWhiteSpace(parsedName))
                {
                    senderPlayerName = parsedName;
                }
            }

            return true;
        }
        catch (JsonException ex)
        {
            Serilog.Log.Warning(ex, "NotificationsCenter failed to parse sender data from notification payload.");
            return false;
        }
    }

    private static bool TryGetLocalizationArguments(string? dataJson, out IReadOnlyList<string> titleArgs, out IReadOnlyList<string> messageArgs)
    {
        titleArgs = Array.Empty<string>();
        messageArgs = Array.Empty<string>();

        if (string.IsNullOrWhiteSpace(dataJson))
        {
            return false;
        }

        try
        {
            using var jsonDocument = JsonDocument.Parse(dataJson);
            if (!jsonDocument.RootElement.TryGetProperty(LocalizationPropertyName, out var localizationElement)
                || localizationElement.ValueKind != JsonValueKind.Object)
            {
                return false;
            }

            titleArgs = ReadStringArray(localizationElement, TitleArgsPropertyName);
            messageArgs = ReadStringArray(localizationElement, MessageArgsPropertyName);
            return true;
        }
        catch (JsonException ex)
        {
            Serilog.Log.Warning(ex, "NotificationsCenter failed to parse localization arguments from notification payload.");
            return false;
        }
    }

    private static string GetNotificationKind(string? dataJson)
    {
        if (string.IsNullOrWhiteSpace(dataJson))
        {
            return string.Empty;
        }

        try
        {
            using var jsonDocument = JsonDocument.Parse(dataJson);
            if (!jsonDocument.RootElement.TryGetProperty(NotificationKindPropertyName, out var notificationKindElement))
            {
                return string.Empty;
            }

            return notificationKindElement.ValueKind == JsonValueKind.String
                ? notificationKindElement.GetString() ?? string.Empty
                : notificationKindElement.ToString();
        }
        catch (JsonException ex)
        {
            Serilog.Log.Warning(ex, "NotificationsCenter failed to parse notification kind from payload.");
            return string.Empty;
        }
    }

    private static string GetResolvedNotificationKind(PlayerNotification notification)
    {
        var notificationKind = GetNotificationKind(notification.DataJson);
        if (!string.Equals(notificationKind, "battle_resolved", StringComparison.OrdinalIgnoreCase))
        {
            return notificationKind;
        }

        var battleResult = GetNotificationDataString(notification.DataJson, ResultPropertyName);
        var attackerWon = battleResult.Contains("attacker_win", StringComparison.OrdinalIgnoreCase);
        var defenderWon = battleResult.Contains("defender_win", StringComparison.OrdinalIgnoreCase);

        return notification.Type switch
        {
            PlayerNotificationType.BattleReportAttacker when attackerWon => "battle_report_attacker_victory",
            PlayerNotificationType.BattleReportAttacker when defenderWon => "battle_report_attacker_defeat",
            PlayerNotificationType.BattleReportDefender when attackerWon => "battle_report_defender_defeat",
            PlayerNotificationType.BattleReportDefender when defenderWon => "battle_report_defender_victory",
            _ => notificationKind
        };
    }

    private static string GetNotificationDataString(string? dataJson, string propertyName)
    {
        if (string.IsNullOrWhiteSpace(dataJson))
        {
            return string.Empty;
        }

        try
        {
            using var jsonDocument = JsonDocument.Parse(dataJson);
            return jsonDocument.RootElement.TryGetProperty(propertyName, out var element)
                ? element.ValueKind == JsonValueKind.String
                    ? element.GetString() ?? string.Empty
                    : element.ToString()
                : string.Empty;
        }
        catch (JsonException ex)
        {
            Serilog.Log.Warning(ex, "NotificationsCenter failed to parse notification string property {PropertyName}.", propertyName);
            return string.Empty;
        }
    }

    private static decimal GetNotificationDecimal(string? dataJson, string propertyName)
    {
        if (string.IsNullOrWhiteSpace(dataJson))
        {
            return 0m;
        }

        try
        {
            using var jsonDocument = JsonDocument.Parse(dataJson);
            if (!jsonDocument.RootElement.TryGetProperty(propertyName, out var element))
            {
                return 0m;
            }

            return element.ValueKind switch
            {
                JsonValueKind.Number when element.TryGetDecimal(out var value) => value,
                JsonValueKind.String when decimal.TryParse(element.GetString(), out var value) => value,
                _ => 0m
            };
        }
        catch (JsonException ex)
        {
            Serilog.Log.Warning(ex, "NotificationsCenter failed to parse notification decimal property {PropertyName}.", propertyName);
            return 0m;
        }
    }

    private static IReadOnlyList<string> ReadStringArray(JsonElement parent, string propertyName)
    {
        if (!parent.TryGetProperty(propertyName, out var arrayElement) || arrayElement.ValueKind != JsonValueKind.Array)
        {
            return Array.Empty<string>();
        }

        var values = new List<string>();
        foreach (var item in arrayElement.EnumerateArray())
        {
            values.Add(item.ValueKind == JsonValueKind.String ? item.GetString() ?? string.Empty : item.ToString());
        }

        return values;
    }

    private void ResetPresentationState()
    {
        CancelDisplayTimer();
        _queuedNotifications.Clear();
        _seenNotificationIds.Clear();
        _activeNotification = null;
    }

