@using VoltrokEF
@using VoltrokServices.Services.Auth
@using VoltrokServices.Services.Players
@using VoltrokServices.Services.Seasons
@using VoltrokUtils.Enums

@inject NavigationManager Navigation
@inject AuthService AuthService
@inject IJSRuntime JsRuntime
@inject PlayersService PlayersService
@inject SeasonService SeasonService

@inherits AppStateComponentBase

<div class="top-bar-stack position-fixed top-0 start-0 end-0">
    @if (HasIncomingThreat)
    {
        <div class="threat-banner" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="threat-banner-copy">
                <div class="threat-banner-eyebrow">
                    <iconify-icon icon="mdi:shield-alert" width="18" height="18"></iconify-icon>
                    <span>@T["parts.topbar.threatBanner.eyebrow"]</span>
                    @if (IncomingAttackSources.Count > 0)
                    {
                        @for (var i = 0; i < IncomingAttackSources.Count; i++)
                        {
                            var attacker = IncomingAttackSources[i];
                            <button type="button" class="threat-banner-player-link" @onclick="() => FocusThreatPlayer(attacker)">
                                @attacker.Name
                            </button>

                            @if (i < IncomingAttackSources.Count - 1)
                            {
                                <span class="threat-banner-separator">,</span>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    }

    <div class="season-banner" role="status" aria-live="polite" aria-atomic="true">
        <div class="season-banner-copy">
            <div class="season-banner-summary">
                <iconify-icon icon="solar:hourglass-bold" width="18" height="18"></iconify-icon>
                @if (_currentSeasonLeaderboard is null)
                {
                    <span class="season-banner-loading">@T["parts.topbar.seasonTicker.loading"]</span>
                }
                else
                {
                    <span>@string.Format(
                        T["parts.topbar.seasonTicker.season"],
                        _currentSeasonLeaderboard.SeasonNumber,
                        GetSeasonRemainingLabel(_currentSeasonLeaderboard.EndsAtUtc))</span>
                }
            </div>

            <div class="season-banner-viewport" aria-label="@T["parts.topbar.seasonTicker.eyebrow"]">
                @if (_currentSeasonLeaderboard is null)
                {
                    <div class="season-banner-loading">@T["parts.topbar.seasonTicker.loading"]</div>
                }
                else
                {
                    <div class="season-banner-track">
                        <div class="season-banner-group">
                            @foreach (var entry in SeasonTickerItems)
                            {
                                <div class="season-banner-item">
                                    <img class="season-banner-flag" src="@entry.FlagUrl" alt="@entry.FlagAlt" />
                                    <span class="season-banner-item-text">@entry.Text</span>
                                </div>
                            }
                        </div>

                        <div class="season-banner-group" aria-hidden="true">
                            @foreach (var entry in SeasonTickerItems)
                            {
                                <div class="season-banner-item">
                                    <img class="season-banner-flag" src="@entry.FlagUrl" alt="" />
                                    <span class="season-banner-item-text">@entry.Text</span>
                                </div>
                            }
                        </div>

                    </div>
                }
            </div>
        </div>
    </div>

    <div class="top-bar d-flex align-items-center justify-content-between pe-4 border-bottom" @onclick:stopPropagation="true">
        <div class="topbar-left d-flex align-items-center gap-3">
            <img src="/logo.png" class="topbar-logo" />
        </div>

        <div class="topbar-right d-flex align-items-center gap-2">
            <div class="topbar-options-control" @onclick:stopPropagation="true">
                <button class="btn btn-secondary d-flex align-items-center justify-content-center gap-2 topbar-options-btn"
                        type="button"
                        @onclick="ToggleOptionsMenu"
                        title="@T["parts.topbar.options"]">
                    <iconify-icon icon="solar:settings-bold-duotone" width="18" height="18"></iconify-icon>
                    <span class="topbar-options-label">@T["parts.topbar.options"]</span>
                </button>

                @if (_showOptionsMenu)
                {
                    <button type="button" class="options-backdrop" @onclick="CloseOptionsMenu" aria-label="@T["parts.topbar.closeOptions"]"></button>
                    <div class="options-menu">
                        <div class="options-menu-header">@T["parts.topbar.options"]</div>

                        <div class="options-section">
                            <div class="options-section-title">@T["layout.map.layers.title"]</div>
                            <button class="layer-option @(AppState.MapBaseLayer == "none" ? "active" : "")" @onclick='() => SetBaseLayer("none")'>
                                <span>@T["layout.map.layers.base.atlas"]</span>
                            </button>
                            <button class="layer-option @(AppState.MapBaseLayer == "carto-dark" ? "active" : "")" @onclick='() => SetBaseLayer("carto-dark")'>
                                <span>@T["layout.map.layers.base.cartoDark"]</span>
                            </button>
                            <button class="layer-option @(AppState.MapBaseLayer == "esri-imagery" ? "active" : "")" @onclick='() => SetBaseLayer("esri-imagery")'>
                                <span>@T["layout.map.layers.base.satellite"]</span>
                            </button>
                        </div>

                        <div class="layer-divider"></div>

                        <div class="options-section">
                            <button class="layer-option layer-toggle" @onclick="TogglePlayersLayer">
                                <span>@T["tabs.region.players"]</span>
                                <input type="checkbox" checked="@AppState.MapShowPlayersLayer" @onclick:preventDefault readonly />
                            </button>

                            <div class="layer-divider"></div>

                            <button class="layer-option layer-toggle" @onclick="ToggleCountriesLayer">
                                <span>@T["layout.map.layers.colors.countries"]</span>
                                <input type="checkbox" checked="@AppState.MapShowCountriesLayer" @onclick:preventDefault readonly />
                            </button>

                            <div class="layer-divider"></div>

                            <button class="layer-option layer-toggle" @onclick="ToggleAttackLayer">
                                <span>@T["layout.map.tooltip.mapMarker.attack"]</span>
                                <input type="checkbox" checked="@AppState.MapShowAttackLayer" @onclick:preventDefault readonly />
                            </button>

                            <div class="layer-divider"></div>

                            <button class="layer-option layer-toggle" @onclick="ToggleSiegeLayer">
                                <span>@T["layout.map.tooltip.mapMarker.siege"]</span>
                                <input type="checkbox" checked="@AppState.MapShowSiegeLayer" @onclick:preventDefault readonly />
                            </button>

                            <div class="layer-divider"></div>

                            <button class="layer-option layer-toggle" @onclick="ToggleTradeLayer">
                                <span>@T["layout.map.tooltip.mapMarker.trade"]</span>
                                <input type="checkbox" checked="@AppState.MapShowTradeLayer" @onclick:preventDefault readonly />
                            </button>
                        </div>

                        <div class="layer-divider"></div>

                        <div class="options-section options-form-section">
                            <div class="options-field">
                                <label class="options-field-label">@T["layout.map.theme"]</label>
                                <select class="form-select form-select-sm layer-theme-select" value="@SelectedTheme" @onchange="OnThemeChanged" title="@T["layout.map.theme"]">
                                    @foreach (var theme in _themeOptions)
                                    {
                                        <option value="@theme.CssClass">@T[theme.Label]</option>
                                    }
                                </select>
                            </div>

                            <div class="options-field">
                                <label class="options-field-label">@T["layout.map.searchPlayers"]</label>
                                <div class="player-search-control">
                                    <input class="player-search-input"
                                           type="text"
                                           placeholder="@T["layout.map.searchPlayers"]"
                                           @bind-value="_playerSearch"
                                           @bind-value:event="oninput"
                                           @onfocus="ShowPlayerSearch" />
                                </div>
                            </div>

                            @if (_showPlayerSearch && !string.IsNullOrWhiteSpace(_playerSearch))
                            {
                                <div class="player-search-menu">
                                    @if (FilteredPlayers.Any())
                                    {
                                        @foreach (var player in FilteredPlayers)
                                        {
                                            <button type="button" class="player-search-option" @onclick="() => SelectPlayer(player)">
                                                <img class="player-search-flag" src="@GetCountryFlagUrl(player)" alt="@GetCountryIsoCode2(player)" />
                                                <span class="player-search-meta">@GetPlayerSearchLabel(player)</span>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <div class="player-search-empty">@T["layout.map.noPlayersMatch"]</div>
                                    }
                                </div>
                            }

                            <div class="options-field">
                                <label class="options-field-label">@T["parts.topbar.language"]</label>
                                <select class="form-select form-select-sm topbar-language-select"
                                        value="@AppState.SelectedLanguage"
                                        @onchange="HandleLanguageChanged"
                                        title="@T["parts.topbar.language"]">
                                    @foreach (var language in _languageOptions)
                                    {
                                        <option value="@language.Code">@T[language.Label]</option>
                                    }
                                </select>
                            </div>

                            <a class="options-link-button"
                               href="https://discord.gg/GdKjdJnRE"
                               target="_blank"
                               rel="noopener noreferrer"
                               title="Discord"
                               aria-label="Discord">
                                <span class="options-link-icon" aria-hidden="true">
                                    <iconify-icon icon="ic:baseline-discord" width="18" height="18"></iconify-icon>
                                </span>
                                <span>Discord</span>
                            </a>
                        </div>
                    </div>
                }
            </div>

            @if (AppState.MyPlayer.PlayersId != Guid.Empty)
            {
                <NotificationsCenter />

                <button class="btn btn-secondary d-flex align-items-center justify-content-center gap-2 topbar-options-btn"
                        @onclick="HandlePremium"
                        title="@T["parts.topbar.premium"]">

                    <iconify-icon icon="solar:crown-bold" width="20" height="20"></iconify-icon>
                    <span class="topbar-options-label">@T["parts.topbar.premium"]</span>
                </button>

                <button class="btn btn-secondary rounded-circle d-flex align-items-center justify-content-center topbar-icon-btn"
                        @onclick="HandleLogout"
                        title="@T["parts.topbar.logout"]">
                    <iconify-icon icon="solar:logout-2-bold" width="20" height="20"></iconify-icon>
                </button>

            }
            else
            {
                <div class="topbar-auth-actions d-flex align-items-center gap-2">
                    <button class="btn btn-primary rounded-pill px-4 fw-bold topbar-action-btn"
                            @onclick="HandleLogin">
                        @T["parts.topbar.login"]
                    </button>
                    <button class="btn btn-primary rounded-pill px-4 fw-bold topbar-action-btn"
                            @onclick="HandleRegister">
                        @T["parts.topbar.register"]
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private sealed record ThemeOption(string CssClass, string Label);
    private sealed record LanguageOption(string Code, string Label);
    private sealed record ThreatCounts(int IncomingAttackCount, int IncomingSiegeCount);
    private sealed record SeasonTickerEntry(string Text, string FlagUrl, string FlagAlt);


    private readonly List<ThemeOption> _themeOptions =
    [
        new("theme-light", "layout.map.theme.light"),
        new("theme-ember", "layout.map.theme.ember"),
        new("theme-forest", "layout.map.theme.forest"),
        new("theme-ocean", "layout.map.theme.ocean"),
        new("theme-night", "layout.map.theme.night"),
        new("theme-crown", "layout.map.theme.crown")
    ];

    private readonly List<LanguageOption> _languageOptions =
    [
        new("en", "parts.topbar.languageOption.en"),
        new("de", "parts.topbar.languageOption.de"),
        new("es", "parts.topbar.languageOption.es"),
        new("fr", "parts.topbar.languageOption.fr"),
        new("it", "parts.topbar.languageOption.it"),
        new("pt", "parts.topbar.languageOption.pt"),
        new("ro", "parts.topbar.languageOption.ro"),
        new("ru", "parts.topbar.languageOption.ru"),
        new("zh", "parts.topbar.languageOption.zh"),
        new("pl", "parts.topbar.languageOption.pl")
    ];


    private bool _showOptionsMenu;
    private bool _showPlayerSearch;
    private bool _playersLoaded;
    private string _playerSearch = string.Empty;
    private List<Player> _players = [];
    private PeriodicTimer? _threatBannerTimer;
    private CancellationTokenSource? _threatBannerCts;
    private int _incomingAttackCount;
    private int _incomingSiegeCount;
    private List<Player> _incomingAttackSources = [];
    private SeasonService.SeasonLeaderboardSnapshot? _currentSeasonLeaderboard;

    private string SelectedTheme => AppState.SelectedTheme;
    private int IncomingAttackCount => _incomingAttackCount;
    private int IncomingSiegeCount => _incomingSiegeCount;
    private IReadOnlyList<Player> IncomingAttackSources => _incomingAttackSources;
    private bool HasIncomingThreat => AppState.MyPlayer?.PlayersId != Guid.Empty && (IncomingAttackCount > 0 || IncomingSiegeCount > 0);
    private IReadOnlyList<SeasonTickerEntry> SeasonTickerItems
        => BuildSeasonTickerItems();
    private IEnumerable<Player> FilteredPlayers
        => string.IsNullOrWhiteSpace(_playerSearch)
            ? []
            : _players
                .Where(player => !string.IsNullOrWhiteSpace(player.Name)
                    && player.Name.Contains(_playerSearch, StringComparison.OrdinalIgnoreCase))
                .OrderBy(player => player.Name)
                .Take(20);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _threatBannerCts = new CancellationTokenSource();
            _threatBannerTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            _ = RunThreatBannerRefreshLoopAsync(_threatBannerCts.Token);
            await RefreshTopBarStatusAsync();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    protected override async Task OnAppStateChangedAsync()
    {
        await RefreshTopBarStatusAsync();
        await base.OnAppStateChangedAsync();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", true);
    }

    private void HandleLogin()
    {
        AppState.OpenModal(ModalTypesEnum.Login);
    }

    private void HandleRegister()
    {
        AppState.OpenModal(ModalTypesEnum.Register);
    }

    private void HandlePremium()
    {
        AppState.OpenModal(ModalTypesEnum.Premium);
    }

    private async Task HandleLanguageChanged(ChangeEventArgs args)
    {
        var selectedCode = ResolveLanguageCode(args.Value?.ToString());
        ApplyLanguage(selectedCode);
        await JsRuntime.InvokeVoidAsync("localStorage.setItem", "selected-language", selectedCode);
    }

    private void ToggleOptionsMenu()
    {
        _showOptionsMenu = !_showOptionsMenu;
        if (!_showOptionsMenu)
        {
            _showPlayerSearch = false;
        }
    }

    private void CloseOptionsMenu()
    {
        _showOptionsMenu = false;
        _showPlayerSearch = false;
    }

    private async Task OnThemeChanged(ChangeEventArgs args)
    {
        var theme = args.Value?.ToString();
        if (theme != null)
        {
            AppState.SetTheme(theme);
            await JsRuntime.InvokeVoidAsync("localStorage.setItem", "selected-theme", theme);
        }
    }

    private async Task SetBaseLayer(string layerId)
    {
        AppState.SetMapBaseLayer(layerId);
        await JsRuntime.InvokeVoidAsync("localStorage.setItem", "map_base_layer", layerId);
    }

    private void TogglePlayersLayer()
    {
        AppState.SetMapShowPlayersLayer(!AppState.MapShowPlayersLayer);
    }

    private void ToggleCountriesLayer()
    {
        AppState.SetMapShowCountriesLayer(!AppState.MapShowCountriesLayer);
    }

    private void ToggleAttackLayer()
    {
        AppState.SetMapShowAttackLayer(!AppState.MapShowAttackLayer);
    }

    private void ToggleSiegeLayer()
    {
        AppState.SetMapShowSiegeLayer(!AppState.MapShowSiegeLayer);
    }

    private void ToggleTradeLayer()
    {
        AppState.SetMapShowTradeLayer(!AppState.MapShowTradeLayer);
    }

    private async Task ShowPlayerSearch()
    {
        _showPlayerSearch = true;
        await EnsurePlayersLoadedAsync();
    }

    private void SelectPlayer(Player player)
    {
        _playerSearch = player.Name;
        _showPlayerSearch = false;
        _showOptionsMenu = false;
        AppState.RequestMapFocus(player.LocationX, player.LocationY, 13);
    }

    private async Task EnsurePlayersLoadedAsync()
    {
        if (_playersLoaded)
        {
            return;
        }

        _players = await PlayersService.GetAllPlayers();
        _playersLoaded = true;
    }

    private async Task RunThreatBannerRefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (_threatBannerTimer is null)
        {
            return;
        }

        try
        {
            while (await _threatBannerTimer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshTopBarStatusAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task RefreshTopBarStatusAsync()
    {
        var playerId = AppState.MyPlayer?.PlayersId;
        if (!playerId.HasValue || playerId == Guid.Empty)
        {
            await UpdateThreatCountsAsync(new ThreatCounts(0, 0));
            await UpdateThreatSourcesAsync([]);
            await UpdateCurrentSeasonLeaderboardAsync(await SeasonService.GetSeasonLeaderboardAsync(25));
            return;
        }

        var countsTask = PlayersService.GetIncomingThreatCountsAsync(playerId.Value);
        var sourcesTask = PlayersService.GetIncomingAttackSourcesAsync(playerId.Value);
        var seasonTask = SeasonService.GetSeasonLeaderboardAsync(25);
        await Task.WhenAll(countsTask, sourcesTask, seasonTask);

        var counts = countsTask.Result;
        await UpdateThreatCountsAsync(new ThreatCounts(counts.IncomingAttackCount, counts.IncomingSiegeCount));
        await UpdateThreatSourcesAsync(sourcesTask.Result);
        await UpdateCurrentSeasonLeaderboardAsync(seasonTask.Result);
    }

    private async Task UpdateThreatCountsAsync(ThreatCounts counts)
    {
        if (_incomingAttackCount == counts.IncomingAttackCount && _incomingSiegeCount == counts.IncomingSiegeCount)
        {
            return;
        }

        _incomingAttackCount = counts.IncomingAttackCount;
        _incomingSiegeCount = counts.IncomingSiegeCount;
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateThreatSourcesAsync(List<Player> sources)
    {
        if (_incomingAttackSources.Count == sources.Count
            && _incomingAttackSources.Select(player => player.PlayersId).SequenceEqual(sources.Select(player => player.PlayersId)))
        {
            return;
        }

        _incomingAttackSources = sources;
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateCurrentSeasonLeaderboardAsync(SeasonService.SeasonLeaderboardSnapshot seasonLeaderboard)
    {
        if (_currentSeasonLeaderboard is not null
            && _currentSeasonLeaderboard.SeasonId == seasonLeaderboard.SeasonId
            && _currentSeasonLeaderboard.SeasonNumber == seasonLeaderboard.SeasonNumber
            && _currentSeasonLeaderboard.EndsAtUtc == seasonLeaderboard.EndsAtUtc
            && _currentSeasonLeaderboard.Players.Count == seasonLeaderboard.Players.Count
            && _currentSeasonLeaderboard.Players.Select(player => player.PlayerId).SequenceEqual(seasonLeaderboard.Players.Select(player => player.PlayerId)))
        {
            return;
        }

        _currentSeasonLeaderboard = seasonLeaderboard;
        await InvokeAsync(StateHasChanged);
    }

    private void FocusThreatPlayer(Player player)
    {
        AppState.RequestMapFocus(player.LocationX, player.LocationY, 13);
    }

    private string GetSeasonRemainingLabel(DateTime? endsAtUtc)
    {
        if (!endsAtUtc.HasValue)
        {
            return T["tabs.military.na"];
        }

        var remaining = endsAtUtc.Value - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero)
        {
            return T["tabs.military.lessThanMinute"];
        }

        var totalMinutes = (int)Math.Ceiling(remaining.TotalMinutes);
        var days = totalMinutes / (24 * 60);
        var hours = (totalMinutes % (24 * 60)) / 60;
        var minutes = totalMinutes % 60;

        if (days > 0)
        {
            return string.Format(T["tabs.country.time.daysHoursMinutes"], days, hours, minutes);
        }

        var parts = new List<string>();

        if (hours > 0)
        {
            parts.Add($"{hours} {PolishPlural(hours, T["tabs.military.hour.singular"], T["tabs.military.hour.paucal"], T["tabs.military.hour.plural"])}");
        }

        if (minutes > 0 || hours == 0)
        {
            parts.Add($"{minutes} {PolishPlural(minutes, T["tabs.military.minute.singular"], T["tabs.military.minute.paucal"], T["tabs.military.minute.plural"])}");
        }

        return string.Join($" {T["tabs.common.and"]} ", parts);
    }

    private IReadOnlyList<SeasonTickerEntry> BuildSeasonTickerItems()
    {
        if (_currentSeasonLeaderboard is null)
        {
            return [];
        }

        var items = new List<SeasonTickerEntry>();
        for (var i = 0; i < Math.Min(20, _currentSeasonLeaderboard.Players.Count); i++)
        {
            var entry = _currentSeasonLeaderboard.Players[i];
            items.Add(new SeasonTickerEntry(
                string.Format(
                    T["parts.topbar.seasonTicker.rank"],
                    i + 1,
                    entry.PlayerName,
                    entry.SeasonScore.ToString("N0")),
                GetSeasonPlayerFlagUrl(entry.CountryFlag, entry.CountryIsoCode2),
                GetSeasonPlayerFlagAlt(entry.CountryName, entry.CountryIsoCode2)));
        }

        return items;
    }

    private void ApplyLanguage(string languageCode)
    {
        T.SetLanguage(languageCode);
        AppState.SetLanguage(languageCode);
    }

    private string ResolveLanguageCode(string? languageCode)
    {
        if (string.IsNullOrWhiteSpace(languageCode))
        {
            return "en";
        }

        var normalized = languageCode.Trim().ToLowerInvariant();
        var primary = normalized.Split('-', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)[0];
        return _languageOptions.Any(option => option.Code == primary)
            ? primary
            : "en";
    }

    private static string GetCountryIsoCode2(Player player)
    {
        var raw = player.Countries.IsoCode2;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "--";
        }

        return raw.Length >= 2
            ? raw[..2].ToUpperInvariant()
            : raw.ToUpperInvariant();
    }

    private static string GetCountryFlagUrl(Player player)
    {
        return GetCountryFlagUrl(player.Countries.Flag, player.Countries.IsoCode2);
    }

    private static string GetCountryFlagUrl(string? flag, string? isoCode2)
    {
        if (!string.IsNullOrWhiteSpace(flag))
        {
            var rawFlag = flag.Trim();
            if (rawFlag.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            {
                return rawFlag;
            }

            if (rawFlag.Length <= 3 && !rawFlag.Contains("/") && !rawFlag.Contains(":"))
            {
                return $"https://flagcdn.com/w40/{rawFlag.ToLowerInvariant()}.png";
            }

            return rawFlag;
        }

        var iso = string.IsNullOrWhiteSpace(isoCode2) ? "--" : isoCode2.Trim().ToUpperInvariant();
        return iso == "--" ? "/logo.png" : $"https://flagcdn.com/w40/{iso.ToLowerInvariant()}.png";
    }

    private static string GetSeasonPlayerFlagUrl(string? flag, string? isoCode2)
        => GetCountryFlagUrl(flag, isoCode2);

    private static string GetSeasonPlayerFlagAlt(string countryName, string? isoCode2)
    {
        var iso = string.IsNullOrWhiteSpace(isoCode2) ? "--" : isoCode2.Trim().ToUpperInvariant();
        return string.IsNullOrWhiteSpace(countryName) ? iso : $"{countryName} ({iso})";
    }

    private string GetPlayerSearchLabel(Player player)
    {
        var iso = GetCountryIsoCode2(player);
        var regionName = string.IsNullOrWhiteSpace(player.Countries.Name) ? T["parts.topbar.search.unknownRegion"] : player.Countries!.Name;
        var playerName = string.IsNullOrWhiteSpace(player.Name) ? T["parts.topbar.search.unknownPlayer"] : player.Name;
        return string.Format(T["parts.topbar.search.resultLabel"], iso, regionName, playerName);
    }

    private static string PolishPlural(int value, string singular, string paucal, string plural)
    {
        if (value == 1)
        {
            return singular;
        }

        var mod10 = value % 10;
        var mod100 = value % 100;
        if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20))
        {
            return paucal;
        }

        return plural;
    }

    public new void Dispose()
    {
        _threatBannerCts?.Cancel();
        _threatBannerTimer?.Dispose();
        _threatBannerCts?.Dispose();
        base.Dispose();
    }
}
