    private List<object> BuildTransportRenderData()
    {
        var now = DateTime.UtcNow;
        var data = new List<object>();

        foreach (var transport in _activeTransports)
        {
            if (!AppState.MapShowTradeLayer)
            {
                continue;
            }

            if (!string.Equals(transport.Status, PlayerTradeStatus.InTransit.ToDbValue(), StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var totalSeconds = (transport.TransportEndTime - transport.TransportStartTime).TotalSeconds;
            var elapsedSeconds = (now - transport.TransportStartTime).TotalSeconds;
            var progress = totalSeconds <= 0 ? 1 : Math.Clamp(elapsedSeconds / totalSeconds, 0, 1);
            var remainingSeconds = Math.Max(0, (transport.TransportEndTime - now).TotalSeconds);
            var fromX = (double?)transport.FromPlayers?.LocationX;
            var fromY = (double?)transport.FromPlayers?.LocationY;
            var toX = (double?)transport.ToPlayers?.LocationX;
            var toY = (double?)transport.ToPlayers?.LocationY;

            var currentX = fromX + (toX - fromX) * progress;
            var currentY = fromY + (toY - fromY) * progress;

            data.Add(new
            {
                movementId = transport.PlayerTradesId,
                movementType = "trade",
                missionType = "transport",
                fromPlayerName = transport.FromPlayers?.Name,
                toPlayerName = transport.ToPlayers?.Name,
                status = transport.Status,
                startTimeUtc = transport.TransportStartTime,
                endTimeUtc = transport.TransportEndTime,
                totalSeconds,
                elapsedSeconds = Math.Max(0, elapsedSeconds),
                remainingSeconds,
                progressPercent = Math.Round(progress * 100, 1),
                fromX = transport.FromPlayers?.LocationX,
                fromY = transport.FromPlayers?.LocationY,
                toX = transport.ToPlayers?.LocationX,
                toY = transport.ToPlayers?.LocationY,
                currentX = (decimal?)currentX,
                currentY = (decimal?)currentY
            });
        }

        foreach (var transport in _activeMilitaryTransports)
        {
            if (transport.Status != PlayerTransportStatus.InProgress.ToDbValue())
            {
                continue;
            }

            var normalizedMissionType = transport.MissionType?.Trim();
            var shouldRenderMilitaryTransport =
                normalizedMissionType switch
                {
                    nameof(PlayerMilitaryTransportMissionType.Siege) => AppState.MapShowSiegeLayer,
                    nameof(PlayerMilitaryTransportMissionType.Attack) => AppState.MapShowAttackLayer,
                    nameof(PlayerMilitaryTransportMissionType.Aid) => AppState.MapShowAttackLayer,
                    _ => AppState.MapShowAttackLayer
                };

            if (!shouldRenderMilitaryTransport)
            {
                continue;
            }

            var totalSeconds = (transport.EndTime - transport.StartTime).TotalSeconds;
            var elapsedSeconds = (now - transport.StartTime).TotalSeconds;
            var progress = totalSeconds <= 0 ? 1 : Math.Clamp(elapsedSeconds / totalSeconds, 0, 1);
            var remainingSeconds = Math.Max(0, (transport.EndTime - now).TotalSeconds);
            var unitEntries = transport.PlayerMilitaryTransportUnits
                .Where(u => u.Quantity > 0)
                .Select(u => new
                {
                    code = u.MilitaryUnitsCode,
                    level = u.Level,
                    quantity = u.Quantity
                })
                .ToList();
            var totalUnitQuantity = unitEntries.Sum(u => u.quantity);
            var totalPower = unitEntries.Sum(u => Math.Max(0, u.level) * Math.Max(0, u.quantity));
            var strongestUnitCode = unitEntries
                .OrderByDescending(u => MilitaryUnitEngine.MilitaryUnitsAllData.FirstOrDefault(x => string.Equals(x.Code.ToString(), u.code, StringComparison.OrdinalIgnoreCase))?.OffensivePoints ?? 0)
                .ThenByDescending(u => u.level)
                .ThenByDescending(u => u.quantity)
                .Select(u => u.code)
                .FirstOrDefault();
            var strongestUnitIconUrl = string.IsNullOrWhiteSpace(strongestUnitCode)
                ? null
                : $"/assets/icons/military_units/{strongestUnitCode.Trim()}.png";

            var fromX = (double?)transport.PlayerFrom?.LocationX;
            var fromY = (double?)transport.PlayerFrom?.LocationY;
            var toX = (double?)transport.PlayerTo?.LocationX;
            var toY = (double?)transport.PlayerTo?.LocationY;

            var currentX = fromX + (toX - fromX) * progress;
            var currentY = fromY + (toY - fromY) * progress;

            data.Add(new
            {
                movementId = transport.PlayerMilitaryTransportsId,
                movementType = "military",
                missionType = normalizedMissionType,
                fromPlayerName = transport.PlayerFrom?.Name,
                toPlayerName = transport.PlayerTo?.Name,
                status = transport.Status,
                autoReturnAfterBattle = transport.AutoReturnAfterBattle,
                createdAtUtc = transport.CreatedAt,
                startTimeUtc = transport.StartTime,
                endTimeUtc = transport.EndTime,
                totalSeconds,
                elapsedSeconds = Math.Max(0, elapsedSeconds),
                remainingSeconds,
                progressPercent = Math.Round(progress * 100, 1),
                itemCount = unitEntries.Count,
                totalQuantity = totalUnitQuantity,
                totalPower,
                strongestUnitCode,
                strongestUnitIconUrl,
                details = string.Join(", ", unitEntries.Select(u => $"L{u.level} x{u.quantity}")),
                items = unitEntries,
                fromX = transport.PlayerFrom?.LocationX,
                fromY = transport.PlayerFrom?.LocationY,
                toX = transport.PlayerTo?.LocationX,
                toY = transport.PlayerTo?.LocationY,
                currentX = (decimal?)currentX,
                currentY = (decimal?)currentY
            });
        }

        return data;
    }

    private List<object> BuildSiegeRenderData()
    {
        return _activeSieges
            .Where(_ => AppState.MapShowSiegeLayer)
            .Where(s => s.Status == PlayerSiegesStatus.Active.ToDbValue())
            .Select(s => new
            {
                strongestUnitCode = s.PlayerSiegeUnits
                    .Where(u => string.Equals(u.Side, Side.Attacker.ToDbValue(), StringComparison.OrdinalIgnoreCase) && u.CurrentQuantity > 0)
                    .OrderByDescending(u => MilitaryUnitEngine.MilitaryUnitsAllData.FirstOrDefault(x => string.Equals(x.Code.ToString(), u.MilitaryUnitsCode, StringComparison.OrdinalIgnoreCase))?.OffensivePoints ?? 0)
                    .ThenByDescending(u => u.Level)
                    .ThenByDescending(u => u.CurrentQuantity)
                    .Select(u => u.MilitaryUnitsCode)
                    .FirstOrDefault(),
                playerSiegesId = s.PlayerSiegesId,
                playerId = s.PlayerToId,
                playerName = s.PlayerTo.Name,
                attackerPlayerName = s.PlayerFrom.Name,
                x = s.PlayerTo.LocationX,
                y = s.PlayerTo.LocationY,
                startedAt = s.StartedAt,
                endedAt = s.EndedAt,
                strongestUnitIconUrl = s.PlayerSiegeUnits
                    .Where(u => string.Equals(u.Side, Side.Attacker.ToDbValue(), StringComparison.OrdinalIgnoreCase) && u.CurrentQuantity > 0)
                    .OrderByDescending(u => MilitaryUnitEngine.MilitaryUnitsAllData.FirstOrDefault(x => string.Equals(x.Code.ToString(), u.MilitaryUnitsCode, StringComparison.OrdinalIgnoreCase))?.OffensivePoints ?? 0)
                    .ThenByDescending(u => u.Level)
                    .ThenByDescending(u => u.CurrentQuantity)
                    .Select(u => $"/assets/icons/military_units/{u.MilitaryUnitsCode.Trim()}.png")
                    .FirstOrDefault()
            })
            .Cast<object>()
            .ToList();
    }

