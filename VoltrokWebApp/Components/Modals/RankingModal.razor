    private string GetCountryLabel(string? isoCode2)
    {
        if (string.IsNullOrWhiteSpace(isoCode2))
        {
            return T["modals.ranking.na"];
        }

        return isoCode2.Length >= 2
            ? isoCode2[..2].ToUpperInvariant()
            : isoCode2.ToUpperInvariant();
    }

    private static string? GetCountryFlagUrl(string? countryFlag, string? isoCode2)
    {
        if (!string.IsNullOrWhiteSpace(countryFlag))
        {
            var rawFlag = countryFlag.Trim();
            if (rawFlag.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            {
                return rawFlag;
            }

            if (rawFlag.Length <= 3 && !rawFlag.Contains("/") && !rawFlag.Contains(":"))
            {
                return $"https://flagcdn.com/w40/{rawFlag.ToLowerInvariant()}.png";
            }

            return rawFlag;
        }

        if (string.IsNullOrWhiteSpace(isoCode2))
        {
            return null;
        }

        var iso = isoCode2.Length >= 2
            ? isoCode2[..2].ToLowerInvariant()
            : isoCode2.ToLowerInvariant();

        return $"https://flagcdn.com/w40/{iso}.png";
    }

    private static void ApplyPositions(List<RankingEntry> entries)
    {
        for (var i = 0; i < entries.Count; i++)
        {
            entries[i] = entries[i] with { Position = i + 1 };
        }
    }

