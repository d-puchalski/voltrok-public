@using Microsoft.EntityFrameworkCore
@using Serilog
@using VoltrokEF
@using VoltrokServices.Services.Seasons
@using VoltrokUtils.Enums
@using VoltrokWebApp.Components.Parts

@inherits AppStateComponentBase
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject SeasonService SeasonService

@if (AppState.ActiveModal == ModalTypesEnum.Ranking)
{
    <div class="info-overlay full-page" @onclick:stopPropagation="true">
        <div class="info-dialog glass-panel ranking-dialog" @onclick:stopPropagation="true">
            <div class="dialog-body-container">
                <div class="main-content-panel w-100">
                    <div class="content-section">
                        @if (_isLoading)
                        {
                            <div class="empty-placeholder">
                                <iconify-icon icon="carbon:circle-dash" width="42" class="mb-2 opacity-50"></iconify-icon>
                                <p>@T["modals.ranking.loading"]</p>
                            </div>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(_error))
                            {
                                <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger">@_error</div>
                            }
                            <div class="ranking-scope-switch mb-3">
                                <button class="ranking-scope-button @GetScopeButtonClass(RankingScope.Players)" @onclick="() => SetScopeAsync(RankingScope.Players)">
                                    <iconify-icon icon="solar:users-group-rounded-bold" class="me-2"></iconify-icon>
                                    @T["modals.ranking.scope.players"]
                                </button>
                                <button class="ranking-scope-button @GetScopeButtonClass(RankingScope.Countries)" @onclick="() => SetScopeAsync(RankingScope.Countries)">
                                    <iconify-icon icon="solar:global-bold" class="me-2"></iconify-icon>
                                    @T["modals.ranking.scope.countries"]
                                </button>
                            </div>
                            <div class="management-tabs mb-3">
                                <button class="management-tab @GetTabButtonClass(LeaderboardTab.Richest)" @onclick="() => SetTabAsync(LeaderboardTab.Richest)">
                                    <iconify-icon icon="solar:wallet-money-bold" class="me-2 text-warning"></iconify-icon>
                                    @T["modals.ranking.tab.richest"]
                                </button>
                                @if (_activeScope == RankingScope.Players)
                                {
                                    <button class="management-tab @GetTabButtonClass(LeaderboardTab.Army)" @onclick="() => SetTabAsync(LeaderboardTab.Army)">
                                        <iconify-icon icon="solar:shield-user-bold" class="me-2 text-danger"></iconify-icon>
                                        @T["modals.ranking.tab.army"]
                                    </button>
                                    <button class="management-tab @GetTabButtonClass(LeaderboardTab.Loot)" @onclick="() => SetTabAsync(LeaderboardTab.Loot)">
                                        <iconify-icon icon="solar:treasure-chest-bold" class="me-2 text-success"></iconify-icon>
                                        @T["modals.ranking.tab.loot"]
                                    </button>
                                    <button class="management-tab @GetTabButtonClass(LeaderboardTab.Trade)" @onclick="() => SetTabAsync(LeaderboardTab.Trade)">
                                        <iconify-icon icon="solar:delivery-bold" class="me-2 text-primary"></iconify-icon>
                                        @T["modals.ranking.tab.trade"]
                                    </button>
                                }
                                else
                                {
                                    <button class="management-tab @GetTabButtonClass(LeaderboardTab.Military)" @onclick="() => SetTabAsync(LeaderboardTab.Military)">
                                        <iconify-icon icon="solar:shield-bold" class="me-2 text-danger"></iconify-icon>
                                        @T["modals.ranking.tab.militaryCountries"]
                                    </button>
                                    <button class="management-tab @GetTabButtonClass(LeaderboardTab.Trade)" @onclick="() => SetTabAsync(LeaderboardTab.Trade)">
                                        <iconify-icon icon="solar:delivery-bold" class="me-2 text-primary"></iconify-icon>
                                        @T["modals.ranking.tab.tradeCountries"]
                                    </button>
                                }

                                <button type="button" class="management-tab modal-close-tab ms-auto" @onclick="CloseModal">
                                    <iconify-icon icon="solar:close-circle-bold" class="me-1"></iconify-icon>
                                    @T["layout.main.dismiss"]
                                </button>
                            </div>
                            <div class="glass-card p-3 ranking-shell">
                                <div class="d-flex align-items-center mb-2">
                                    <iconify-icon icon="@GetCurrentRankingIcon()" class="me-2 @GetCurrentRankingIconClass()"></iconify-icon>
                                    <h6 class="m-0 text-white">@GetCurrentRankingTitle()</h6>
                                </div>
                                @if (GetCurrentEntries().Count == 0)
                                {
                                    <div class="small text-muted">@T["modals.ranking.noData"]</div>
                                }
                                else
                                {
                                    @if (GetPodiumEntries().Count > 0)
                                    {
                                        <div class="ranking-podium-tree">
                                            @if (GetPodiumEntries().FirstOrDefault(entry => entry.Position == 1) is RankingEntry winner)
                                            {
                                                <div class="ranking-podium-winner-wrap">
                                                    <div class="ranking-podium-card ranking-podium-card-winner building-card-large @(winner.IsMine ? "ranking-is-mine" : string.Empty)">
                                                        @RenderAvatar(winner, true)
                                                        <div class="ranking-podium-role">#1</div>
                                                        <div class="ranking-podium-name">@RenderEntryName(winner)</div>
                                                        <div class="ranking-podium-country">
                                                            @RenderEntryMeta(winner)
                                                        </div>
                                                        <div class="ranking-podium-value">@winner.ValueLabel</div>
                                                    </div>
                                                </div>
                                            }

                                            @if (GetPodiumEntries().Count > 1)
                                            {
                                                <div class="ranking-podium-connector" aria-hidden="true">
                                                    <span class="ranking-podium-connector-line"></span>
                                                </div>
                                                <div class="ranking-podium-members-grid">
                                                    @foreach (var entry in GetPodiumEntries().Where(e => e.Position > 1).OrderBy(e => e.Position))
                                                    {
                                                        <div class="ranking-podium-card ranking-podium-card-member building-card-large @(entry.IsMine ? "ranking-is-mine" : string.Empty)">
                                                            @RenderAvatar(entry, false)
                                                            <div class="ranking-podium-role">#@entry.Position</div>
                                                            <div class="ranking-podium-name">@RenderEntryName(entry)</div>
                                                            <div class="ranking-podium-country">
                                                                @RenderEntryMeta(entry)
                                                            </div>
                                                            <div class="ranking-podium-meta">@entry.ValueLabel</div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (GetCardEntries().Count > 0)
                                    {
                                        <div class="ranking-card-grid">
                                            @foreach (var entry in GetCardEntries())
                                            {
                                                <div class="ranking-spotlight-card building-card-large @(entry.IsMine ? "ranking-is-mine" : string.Empty)">
                                                    <div class="ranking-spotlight-head">
                                                        <span class="ranking-spotlight-rank">#@entry.Position</span>
                                                        <span class="ranking-spotlight-value">@entry.ValueLabel</span>
                                                    </div>
                                                    <div class="ranking-spotlight-body">
                                                        @RenderAvatar(entry, false)
                                                        <div class="ranking-spotlight-content">
                                                            <div class="ranking-spotlight-name">@RenderEntryName(entry)</div>
                                                            <div class="ranking-spotlight-country">@RenderEntryMeta(entry)</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (GetCurrentPagedEntries().Count > 0)
                                    {
                                        @if (GetCurrentTotalPages() > 1)
                                        {
                                            <div class="trade-pager mb-3">
                                                <small class="trade-pager-summary">@GetGridPageStart()-@GetGridPageEnd() / @GetCurrentEntries().Count</small>
                                                <div class="trade-pager-controls" role="group" aria-label="@T["modals.ranking.pagination.topAriaLabel"]">
                                                    <button type="button" class="trade-pager-btn" @onclick="FirstPage" disabled="@(GetCurrentPage() <= 1)">«</button>
                                                    <button type="button" class="trade-pager-btn" @onclick="PrevPage" disabled="@(GetCurrentPage() <= 1)">‹</button>
                                                    <button type="button" class="trade-pager-btn" @onclick="NextPage" disabled="@(GetCurrentPage() >= GetCurrentTotalPages())">›</button>
                                                    <button type="button" class="trade-pager-btn" @onclick="LastPage" disabled="@(GetCurrentPage() >= GetCurrentTotalPages())">»</button>
                                                </div>
                                            </div>
                                        }

                                        <div class="ranking-grid-list">
                                            @foreach (var entry in GetCurrentPagedEntries())
                                            {
                                                <div class="ranking-grid-card @(entry.IsMine ? "ranking-is-mine" : string.Empty)">
                                                    <div class="ranking-grid-rank">#@entry.Position</div>
                                                    <div class="ranking-grid-main">
                                                        <div class="ranking-grid-name">@RenderEntryName(entry)</div>
                                                        <div class="ranking-grid-country">@RenderEntryMeta(entry)</div>
                                                    </div>
                                                    <div class="ranking-grid-value">@entry.ValueLabel</div>
                                                </div>
                                            }
                                        </div>

                                        @if (GetCurrentTotalPages() > 1)
                                        {
                                            <div class="trade-pager mt-3">
                                                <small class="trade-pager-summary">@GetGridPageStart()-@GetGridPageEnd() / @GetCurrentEntries().Count</small>
                                                <div class="trade-pager-controls" role="group" aria-label="@T["modals.ranking.pagination.bottomAriaLabel"]">
                                                    <button type="button" class="trade-pager-btn" @onclick="FirstPage" disabled="@(GetCurrentPage() <= 1)">«</button>
                                                    <button type="button" class="trade-pager-btn" @onclick="PrevPage" disabled="@(GetCurrentPage() <= 1)">‹</button>
                                                    <button type="button" class="trade-pager-btn" @onclick="NextPage" disabled="@(GetCurrentPage() >= GetCurrentTotalPages())">›</button>
                                                    <button type="button" class="trade-pager-btn" @onclick="LastPage" disabled="@(GetCurrentPage() >= GetCurrentTotalPages())">»</button>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                            </div>

                            <div class="glass-card p-3 mt-3 season-archive-shell">
                                <div class="season-archive-head">
                                    <div>
                                        <div class="season-archive-kicker">Season leaderboard archive</div>
                                        <h6 class="m-0 text-white">Browse closed seasons</h6>
                                    </div>

                                    @if (_seasonArchive.Count > 0)
                                    {
                                        <select class="form-select season-archive-select" value="@(_selectedSeasonId?.ToString() ?? string.Empty)" @onchange="HandleSeasonSelectionChanged">
                                            @foreach (var season in _seasonArchive)
                                            {
                                                <option value="@season.SeasonId">@GetSeasonLabel(season)</option>
                                            }
                                        </select>
                                    }
                                </div>

                                @if (_isSeasonLoading)
                                {
                                    <div class="small text-muted">Loading season archive...</div>
                                }
                                else if (_selectedSeasonLeaderboard is null)
                                {
                                    <div class="small text-muted">No completed season leaderboard yet.</div>
                                }
                                else
                                {
                                    <div class="season-archive-summary">
                                        <div class="season-archive-stat">
                                            <span class="season-archive-stat-label">Season</span>
                                            <strong>#@_selectedSeasonLeaderboard.SeasonNumber</strong>
                                        </div>
                                        <div class="season-archive-stat">
                                            <span class="season-archive-stat-label">Window</span>
                                            <strong>@FormatSeasonRange(_selectedSeasonLeaderboard.StartsAtUtc, _selectedSeasonLeaderboard.EndsAtUtc)</strong>
                                        </div>
                                        <div class="season-archive-stat">
                                            <span class="season-archive-stat-label">Ended</span>
                                            <strong>@(_selectedSeasonArchive?.ClosedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</strong>
                                        </div>
                                        <div class="season-archive-stat">
                                            <span class="season-archive-stat-label">Winner</span>
                                            <strong>@(_selectedSeasonArchive?.WinnerPlayerName ?? "-")</strong>
                                        </div>
                                        <div class="season-archive-stat">
                                            <span class="season-archive-stat-label">Winning country</span>
                                            <strong>@(_selectedSeasonArchive?.WinnerCountryName ?? "-")</strong>
                                        </div>
                                    </div>

                                    <div class="season-archive-columns">
                                        <div class="season-archive-column">
                                            <div class="season-archive-column-title">Top players</div>
                                            @if (_selectedSeasonLeaderboard.Players.Count == 0)
                                            {
                                                <div class="small text-muted">No player entries.</div>
                                            }
                                            else
                                            {
                                                <div class="season-archive-list">
                                                    @for (var i = 0; i < _selectedSeasonLeaderboard.Players.Count; i++)
                                                    {
                                                        var entry = _selectedSeasonLeaderboard.Players[i];
                                                        <div class="season-archive-row">
                                                            <div class="season-archive-row-rank">#@(i + 1)</div>
                                                            <div class="season-archive-row-main">
                                                                <div class="season-archive-row-name">@entry.PlayerName</div>
                                                                <div class="season-archive-row-meta">
                                                                    @entry.CountryName
                                                                </div>
                                                                <div class="season-archive-row-meta">
                                                                    @entry.PlayerMoney.ToString("N2") / @entry.PlayerOil.ToString("N2") / @entry.PlayerUranium.ToString("N2") / @entry.PlayerChips.ToString("N2")
                                                                </div>
                                                            </div>
                                                            <div class="season-archive-row-score">@entry.SeasonScore.ToString("N2")</div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <div class="season-archive-column">
                                            <div class="season-archive-column-title">Top countries</div>
                                            @if (_selectedSeasonLeaderboard.Countries.Count == 0)
                                            {
                                                <div class="small text-muted">No country entries.</div>
                                            }
                                            else
                                            {
                                                <div class="season-archive-list">
                                                    @for (var i = 0; i < _selectedSeasonLeaderboard.Countries.Count; i++)
                                                    {
                                                        var entry = _selectedSeasonLeaderboard.Countries[i];
                                                        <div class="season-archive-row">
                                                            <div class="season-archive-row-rank">#@(i + 1)</div>
                                                            <div class="season-archive-row-main">
                                                                <div class="season-archive-row-name">@entry.CountryName</div>
                                                                <div class="season-archive-row-meta">
                                                                    @entry.CountryMoney.ToString("N2") / @entry.CountryOil.ToString("N2") / @entry.CountryUranium.ToString("N2") / @entry.CountryChips.ToString("N2")
                                                                </div>
                                                            </div>
                                                            <div class="season-archive-row-score">@entry.SeasonScore.ToString("N2")</div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const int RankingLimit = 100;
    private const int RankingPageSize = 15;
    private bool _isLoading;
    private string? _error;
    private bool _isSeasonLoading;
    private List<RankingEntry> _richestPlayers = [];
    private List<RankingEntry> _largestArmyPlayers = [];
    private List<RankingEntry> _largestLootPlayers = [];
    private List<RankingEntry> _largestTradePlayers = [];
    private List<RankingEntry> _richestCountries = [];
    private List<RankingEntry> _largestMilitaryCountries = [];
    private List<RankingEntry> _largestTradeCountries = [];
    private IReadOnlyList<SeasonService.SeasonArchiveItem> _seasonArchive = [];
    private SeasonService.SeasonArchiveItem? _selectedSeasonArchive;
    private SeasonService.SeasonLeaderboardSnapshot? _selectedSeasonLeaderboard;
    private Guid? _selectedSeasonId;
    private RankingScope _activeScope = RankingScope.Players;
    private LeaderboardTab _activeTab = LeaderboardTab.Richest;
    private readonly Dictionary<string, int> _currentPages = new();
    private bool _wasOpen;

    protected override async Task OnInitializedAsync()
    {
        await LoadRankingsAsync();
        _wasOpen = AppState.ActiveModal == ModalTypesEnum.Ranking;
    }

    protected override async Task OnAppStateChangedAsync()
    {
        var isOpen = AppState.ActiveModal == ModalTypesEnum.Ranking;
        if (isOpen && !_wasOpen)
        {
            await LoadRankingsAsync();
        }

        _wasOpen = isOpen;
    }

    private async Task LoadRankingsAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var myPlayerId = AppState.MyPlayer?.PlayersId;
            var myCountryId = AppState.MyPlayer?.CountriesId;
            var players = db.Players.AsNoTracking();
            var countries = db.Countries.AsNoTracking();
            var playerWithCountry = players
                .GroupJoin(
                    countries,
                    player => player.CountriesId,
                    country => country.CountriesId,
                    (player, group) => new { Player = player, Country = group.FirstOrDefault() });

            var richestPlayerRows = await playerWithCountry
                .OrderByDescending(v => v.Player.Money)
                .Take(RankingLimit)
                .Select(v => new
                {
                    EntityId = v.Player.PlayersId,
                    v.Player.Name,
                    Score = v.Player.Money,
                    v.Player.LocationX,
                    v.Player.LocationY,
                    v.Player.PlayerAvatar,
                    v.Player.IsNpc,
                    IsMine = myPlayerId == v.Player.PlayersId,
                    CountryFlag = v.Country != null ? v.Country.Flag : null,
                    CountryIsoCode2 = v.Country != null ? v.Country.IsoCode2 : null
                })
                .ToListAsync();
            _richestPlayers = richestPlayerRows
                .Select(row => new RankingEntry(
                    RankingEntryType.Player,
                    row.EntityId,
                    row.Name,
                    row.Score,
                    FormatMoney(row.Score),
                    row.IsMine,
                    GetCountryFlagUrl(row.CountryFlag, row.CountryIsoCode2),
                    GetCountryLabel(row.CountryIsoCode2),
                    row.EntityId,
                    row.LocationX,
                    row.LocationY,
                    row.PlayerAvatar,
                    row.IsNpc))
                .ToList();

            var armyAgg = db.PlayerMilitaryUnits
                .AsNoTracking()
                .GroupBy(military => military.PlayersId)
                .Select(g => new { PlayerId = g.Key, Value = g.Sum(x => x.Quantity) });

            var largestArmyRows = await armyAgg
                .OrderByDescending(a => a.Value)
                .Take(RankingLimit)
                .Join(
                    playerWithCountry,
                    a => a.PlayerId,
                    v => v.Player.PlayersId,
                    (a, v) => new
                    {
                        EntityId = v.Player.PlayersId,
                        Name = v.Player.Name,
                        Score = (decimal)a.Value,
                        v.Player.LocationX,
                        v.Player.LocationY,
                        v.Player.PlayerAvatar,
                        v.Player.IsNpc,
                        IsMine = myPlayerId == v.Player.PlayersId,
                        CountryFlag = v.Country != null ? v.Country.Flag : null,
                        CountryIsoCode2 = v.Country != null ? v.Country.IsoCode2 : null
                    })
                .ToListAsync();
            _largestArmyPlayers = largestArmyRows
                .Select(row => new RankingEntry(
                    RankingEntryType.Player,
                    row.EntityId,
                    row.Name,
                    row.Score,
                    $"{row.Score:N0}",
                    row.IsMine,
                    GetCountryFlagUrl(row.CountryFlag, row.CountryIsoCode2),
                    GetCountryLabel(row.CountryIsoCode2),
                    row.EntityId,
                    row.LocationX,
                    row.LocationY,
                    row.PlayerAvatar,
                    row.IsNpc))
                .ToList();

            var lootAgg = db.PlayerBattleReports
                .AsNoTracking()
                .GroupBy(r => r.PlayerFromId)
                .Select(g => new { PlayerId = g.Key, Value = g.Sum(x => x.LootMoney) });

            var largestLootRows = await lootAgg
                .OrderByDescending(l => l.Value)
                .Take(RankingLimit)
                .Join(
                    playerWithCountry,
                    l => l.PlayerId,
                    v => v.Player.PlayersId,
                    (l, v) => new
                    {
                        EntityId = v.Player.PlayersId,
                        v.Player.Name,
                        Score = l.Value,
                        v.Player.LocationX,
                        v.Player.LocationY,
                        v.Player.PlayerAvatar,
                        v.Player.IsNpc,
                        IsMine = myPlayerId == v.Player.PlayersId,
                        CountryFlag = v.Country != null ? v.Country.Flag : null,
                        CountryIsoCode2 = v.Country != null ? v.Country.IsoCode2 : null
                    })
                .ToListAsync();
            _largestLootPlayers = largestLootRows
                .Select(row => new RankingEntry(
                    RankingEntryType.Player,
                    row.EntityId,
                    row.Name,
                    row.Score,
                    FormatMoney(row.Score),
                    row.IsMine,
                    GetCountryFlagUrl(row.CountryFlag, row.CountryIsoCode2),
                    GetCountryLabel(row.CountryIsoCode2),
                    row.EntityId,
                    row.LocationX,
                    row.LocationY,
                    row.PlayerAvatar,
                    row.IsNpc))
                .ToList();

            var tradeAgg = db.PlayerTrades
                .AsNoTracking()
                .GroupBy(t => t.FromPlayersId)
                .Select(g => new { PlayerId = g.Key, Value = g.Sum(x => x.TotalPrice) });

            var largestTradeRows = await tradeAgg
                .OrderByDescending(t => t.Value)
                .Take(RankingLimit)
                .Join(
                    playerWithCountry,
                    t => t.PlayerId,
                    v => v.Player.PlayersId,
                    (t, v) => new
                    {
                        EntityId = v.Player.PlayersId,
                        v.Player.Name,
                        Score = t.Value,
                        v.Player.LocationX,
                        v.Player.LocationY,
                        v.Player.PlayerAvatar,
                        v.Player.IsNpc,
                        IsMine = myPlayerId == v.Player.PlayersId,
                        CountryFlag = v.Country != null ? v.Country.Flag : null,
                        CountryIsoCode2 = v.Country != null ? v.Country.IsoCode2 : null
                    })
                .ToListAsync();
            _largestTradePlayers = largestTradeRows
                .Select(row => new RankingEntry(
                    RankingEntryType.Player,
                    row.EntityId,
                    row.Name,
                    row.Score,
                    FormatMoney(row.Score),
                    row.IsMine,
                    GetCountryFlagUrl(row.CountryFlag, row.CountryIsoCode2),
                    GetCountryLabel(row.CountryIsoCode2),
                    row.EntityId,
                    row.LocationX,
                    row.LocationY,
                    row.PlayerAvatar,
                    row.IsNpc))
                .ToList();

            var countryMemberCounts = players
                .AsNoTracking()
                .GroupBy(player => player.CountriesId)
                .Select(g => new
                {
                    CountryId = g.Key,
                    Members = g.Count()
                });

            var richestCountryRows = await countries
                .GroupJoin(
                    countryMemberCounts,
                    country => country.CountriesId,
                    members => members.CountryId,
                    (country, members) => new
                    {
                        Country = country,
                        Members = members.Select(v => v.Members).FirstOrDefault()
                    })
                .OrderByDescending(v => v.Country.Money)
                .Take(RankingLimit)
                .ToListAsync();
            _richestCountries = richestCountryRows
                .Select(row => new RankingEntry(
                    RankingEntryType.Country,
                    row.Country.CountriesId,
                    row.Country.Name,
                    row.Country.Money,
                    FormatMoney(row.Country.Money),
                    myCountryId == row.Country.CountriesId,
                    null,
                    string.Format(T["modals.ranking.meta.players"], row.Members),
                    null,
                    null,
                    null,
                    GetCountryFlagUrl(row.Country.Flag, row.Country.IsoCode2),
                    false))
                .ToList();

            var militaryByCountry = armyAgg
                .Join(
                    players,
                    military => military.PlayerId,
                    player => player.PlayersId,
                    (military, player) => new
                    {
                        CountryId = player.CountriesId,
                        military.Value
                    })
                .GroupBy(row => row.CountryId)
                .Select(g => new
                {
                    CountryId = g.Key,
                    Value = g.Sum(x => x.Value)
                });

            var largestMilitaryCountryRows = await countries
                .Join(
                    militaryByCountry,
                    country => country.CountriesId,
                    military => military.CountryId,
                    (country, military) => new
                    {
                        Country = country,
                        Score = (decimal)military.Value
                    })
                .GroupJoin(
                    countryMemberCounts,
                    row => row.Country.CountriesId,
                    members => members.CountryId,
                    (row, members) => new
                    {
                        row.Country,
                        row.Score,
                        Members = members.Select(v => v.Members).FirstOrDefault()
                    })
                .OrderByDescending(row => row.Score)
                .Take(RankingLimit)
                .ToListAsync();
            _largestMilitaryCountries = largestMilitaryCountryRows
                .Select(row => new RankingEntry(
                    RankingEntryType.Country,
                    row.Country.CountriesId,
                    row.Country.Name,
                    row.Score,
                    $"{row.Score:N0}",
                    myCountryId == row.Country.CountriesId,
                    null,
                    string.Format(T["modals.ranking.meta.players"], row.Members),
                    null,
                    null,
                    null,
                    GetCountryFlagUrl(row.Country.Flag, row.Country.IsoCode2),
                    false))
                .ToList();

            var tradeByCountry = db.PlayerTrades
                .AsNoTracking()
                .Join(
                    players,
                    trade => trade.FromPlayersId,
                    player => player.PlayersId,
                    (trade, player) => new
                    {
                        CountryId = player.CountriesId,
                        trade.TotalPrice
                    })
                .GroupBy(row => row.CountryId)
                .Select(g => new
                {
                    CountryId = g.Key,
                    Value = g.Sum(x => x.TotalPrice)
                });

            var largestTradeCountryRows = await countries
                .Join(
                    tradeByCountry,
                    country => country.CountriesId,
                    trade => trade.CountryId,
                    (country, trade) => new
                    {
                        Country = country,
                        Score = trade.Value
                    })
                .GroupJoin(
                    countryMemberCounts,
                    row => row.Country.CountriesId,
                    members => members.CountryId,
                    (row, members) => new
                    {
                        row.Country,
                        row.Score,
                        Members = members.Select(v => v.Members).FirstOrDefault()
                    })
                .OrderByDescending(row => row.Score)
                .Take(RankingLimit)
                .ToListAsync();
            _largestTradeCountries = largestTradeCountryRows
                .Select(row => new RankingEntry(
                    RankingEntryType.Country,
                    row.Country.CountriesId,
                    row.Country.Name,
                    row.Score,
                    FormatMoney(row.Score),
                    myCountryId == row.Country.CountriesId,
                    null,
                    string.Format(T["modals.ranking.meta.players"], row.Members),
                    null,
                    null,
                    null,
                    GetCountryFlagUrl(row.Country.Flag, row.Country.IsoCode2),
                    false))
                .ToList();

            ApplyPositions(_richestPlayers);
            ApplyPositions(_largestArmyPlayers);
            ApplyPositions(_largestLootPlayers);
            ApplyPositions(_largestTradePlayers);
            ApplyPositions(_richestCountries);
            ApplyPositions(_largestMilitaryCountries);
            ApplyPositions(_largestTradeCountries);
            MoveToMyEntryPages();
            await LoadSeasonArchiveAsync();
        }
        catch (Exception ex)
        {
            Log.Error(ex, "{LogPrefix}", T["modals.ranking.error.logPrefix"]);
            _error = T["modals.ranking.error.loadFailed"];
            _richestPlayers = [];
            _largestArmyPlayers = [];
            _largestLootPlayers = [];
            _largestTradePlayers = [];
            _richestCountries = [];
            _largestMilitaryCountries = [];
            _largestTradeCountries = [];
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadSeasonArchiveAsync()
    {
        _isSeasonLoading = true;

        try
        {
            _seasonArchive = await SeasonService.GetCompletedSeasonsAsync(12);

            if (_seasonArchive.Count == 0)
            {
                _selectedSeasonId = null;
                _selectedSeasonArchive = null;
                _selectedSeasonLeaderboard = null;
                return;
            }

            if (_selectedSeasonId is null || !_seasonArchive.Any(item => item.SeasonId == _selectedSeasonId))
            {
                _selectedSeasonId = _seasonArchive.First().SeasonId;
            }

            await LoadSelectedSeasonAsync();
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to load season archive.");
            _seasonArchive = [];
            _selectedSeasonArchive = null;
            _selectedSeasonLeaderboard = null;
        }
        finally
        {
            _isSeasonLoading = false;
        }
    }

    private async Task LoadSelectedSeasonAsync()
    {
        if (_selectedSeasonId is null)
        {
            _selectedSeasonArchive = null;
            _selectedSeasonLeaderboard = null;
            return;
        }

        _selectedSeasonArchive = _seasonArchive.FirstOrDefault(item => item.SeasonId == _selectedSeasonId);
        _selectedSeasonLeaderboard = await SeasonService.GetSeasonLeaderboardAsync(_selectedSeasonId.Value, 10);
    }

    private async Task HandleSeasonSelectionChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var seasonId))
        {
            return;
        }

        _selectedSeasonId = seasonId;
        _isSeasonLoading = true;

        try
        {
            await LoadSelectedSeasonAsync();
        }
        finally
        {
            _isSeasonLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private List<RankingEntry> GetCurrentEntries()
    {
        if (_activeScope == RankingScope.Countries)
        {
            return _activeTab switch
            {
                LeaderboardTab.Military => _largestMilitaryCountries,
                LeaderboardTab.Trade => _largestTradeCountries,
                _ => _richestCountries
            };
        }

        return _activeTab switch
        {
            LeaderboardTab.Army => _largestArmyPlayers,
            LeaderboardTab.Loot => _largestLootPlayers,
            LeaderboardTab.Trade => _largestTradePlayers,
            _ => _richestPlayers
        };
    }

