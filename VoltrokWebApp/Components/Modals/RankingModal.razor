    private void CloseModal()
    {
        AppState?.CloseModal();
    }

    private void OpenPlayerOverview(RankingEntry entry)
    {
        if (entry.MapLocationX.HasValue && entry.MapLocationY.HasValue)
        {
            AppState.RequestMapFocus(entry.MapLocationX.Value, entry.MapLocationY.Value, 13);
            AppState.CloseModal();
            return;
        }

        if (!entry.PlayerId.HasValue)
        {
            return;
        }

        AppState.SetPlayerInfo(entry.PlayerId.Value);
        AppState.OpenModal(ModalTypesEnum.Player);
    }

    private int GetCurrentPage()
    {
        var pageKey = GetCurrentPageKey();
        if (!_currentPages.TryGetValue(pageKey, out var currentPage))
        {
            currentPage = 1;
            _currentPages[pageKey] = currentPage;
        }

        var totalPages = GetCurrentTotalPages();
        return Math.Max(1, Math.Min(currentPage, totalPages));
    }

    private int GetCurrentTotalPages()
    {
        var totalCount = Math.Max(0, GetCurrentEntries().Count - 10);
        return Math.Max(1, (int)Math.Ceiling(totalCount / (double)RankingPageSize));
    }

    private List<RankingEntry> GetCurrentPagedEntries()
    {
        var currentPage = GetCurrentPage();
        return GetCurrentEntries()
            .Skip(10 + ((currentPage - 1) * RankingPageSize))
            .Take(RankingPageSize)
            .ToList();
    }

    private List<RankingEntry> GetPodiumEntries()
        => GetCurrentEntries().Take(3).ToList();

    private List<RankingEntry> GetCardEntries()
        => GetCurrentEntries().Skip(3).Take(5).ToList();

    private int GetGridPageStart()
    {
        var gridEntries = GetCurrentPagedEntries();
        return gridEntries.Count == 0 ? 0 : 11 + ((GetCurrentPage() - 1) * RankingPageSize);
    }

    private int GetGridPageEnd()
    {
        var gridEntries = GetCurrentPagedEntries();
        var pageStart = GetGridPageStart();
        return gridEntries.Count == 0 ? 0 : pageStart + gridEntries.Count - 1;
    }

    private void MoveToMyEntryPages()
    {
        _currentPages[GetPageKey(RankingScope.Players, LeaderboardTab.Richest)] = GetPageForMyEntry(_richestPlayers);
        _currentPages[GetPageKey(RankingScope.Players, LeaderboardTab.Army)] = GetPageForMyEntry(_largestArmyPlayers);
        _currentPages[GetPageKey(RankingScope.Players, LeaderboardTab.Loot)] = GetPageForMyEntry(_largestLootPlayers);
        _currentPages[GetPageKey(RankingScope.Players, LeaderboardTab.Trade)] = GetPageForMyEntry(_largestTradePlayers);
        _currentPages[GetPageKey(RankingScope.Countries, LeaderboardTab.Richest)] = GetPageForMyEntry(_richestCountries);
        _currentPages[GetPageKey(RankingScope.Countries, LeaderboardTab.Military)] = GetPageForMyEntry(_largestMilitaryCountries);
        _currentPages[GetPageKey(RankingScope.Countries, LeaderboardTab.Trade)] = GetPageForMyEntry(_largestTradeCountries);
    }

    private static int GetPageForMyEntry(List<RankingEntry> entries)
    {
        var index = entries.FindIndex(entry => entry.IsMine);
        if (index < 10)
        {
            return 1;
        }

        return ((index - 10) / RankingPageSize) + 1;
    }

    private Task FirstPage()
    {
        _currentPages[GetCurrentPageKey()] = 1;
        return Task.CompletedTask;
    }

    private Task PrevPage()
    {
        _currentPages[GetCurrentPageKey()] = Math.Max(1, GetCurrentPage() - 1);
        return Task.CompletedTask;
    }

    private Task NextPage()
    {
        _currentPages[GetCurrentPageKey()] = Math.Min(GetCurrentTotalPages(), GetCurrentPage() + 1);
        return Task.CompletedTask;
    }

    private Task LastPage()
    {
        _currentPages[GetCurrentPageKey()] = GetCurrentTotalPages();
        return Task.CompletedTask;
    }

    private string GetCurrentPageKey() => GetPageKey(_activeScope, _activeTab);

    private static string GetPageKey(RankingScope scope, LeaderboardTab tab) => $"{scope}:{tab}";

    private static LeaderboardTab NormalizePlayerTab(LeaderboardTab tab)
        => tab is LeaderboardTab.Military ? LeaderboardTab.Army : tab;

    private static LeaderboardTab NormalizeCountryTab(LeaderboardTab tab)
        => tab is LeaderboardTab.Army or LeaderboardTab.Loot ? LeaderboardTab.Richest : tab;

    private static string FormatMoney(decimal value) => $"₿ {value:N2}";

    private record RankingEntry(
        RankingEntryType EntryType,
        Guid EntityId,
        string Name,
        decimal Score,
        string ValueLabel,
        bool IsMine,
        string? MetaFlagUrl,
        string MetaLabel,
        Guid? PlayerId,
        decimal? MapLocationX,
        decimal? MapLocationY,
        string? AvatarUrl,
        bool IsNpc)
    {
        public int Position { get; init; }
    }

    private enum RankingScope
    {
        Players,
        Countries
    }

    private enum RankingEntryType
    {
        Player,
        Country
    }

    private enum LeaderboardTab
    {
        Richest,
        Army,
        Loot,
        Trade,
        Military
    }
}

