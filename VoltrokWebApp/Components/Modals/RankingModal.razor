        => $"Season #{season.SeasonNumber} ({season.StartsAtUtc:yyyy-MM-dd})";

    private Task SetTabAsync(LeaderboardTab tab)
    {
        if (_activeTab == tab)
        {
            return Task.CompletedTask;
        }

        _activeTab = tab;
        var pageKey = GetCurrentPageKey();
        if (!_currentPages.ContainsKey(pageKey))
        {
            _currentPages[pageKey] = 1;
        }

        return Task.CompletedTask;
    }

    private Task SetScopeAsync(RankingScope scope)
    {
        if (_activeScope == scope)
        {
            return Task.CompletedTask;
        }

        _activeScope = scope;
        _activeTab = scope == RankingScope.Players
            ? NormalizePlayerTab(_activeTab)
            : NormalizeCountryTab(_activeTab);

        var pageKey = GetCurrentPageKey();
        if (!_currentPages.ContainsKey(pageKey))
        {
            _currentPages[pageKey] = 1;
        }

        return Task.CompletedTask;
    }

