        await LoadTradesAsync();
    }

    private Task GoToPreviousPageAsync() => GoToPageAsync(_currentPage - 1);
    private Task GoToNextPageAsync() => GoToPageAsync(_currentPage + 1);

    private static List<int> GetVisiblePageNumbers(int currentPage, int totalPages)
    {
        if (totalPages <= 0)
        {
            return [];
        }

        const int radius = 2;
        var start = Math.Max(1, currentPage - radius);
        var end = Math.Min(totalPages, currentPage + radius);
        var result = new List<int>();

        for (var page = start; page <= end; page++)
        {
            result.Add(page);
        }

        return result;
    }

