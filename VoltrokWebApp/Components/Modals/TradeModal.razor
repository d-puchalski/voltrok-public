    private static string FormatNullableDecimal(decimal? value) => value?.ToString() ?? string.Empty;

    private static decimal? ParseNullableDecimal(string? rawValue)
    {
        if (string.IsNullOrWhiteSpace(rawValue))
        {
            return null;
        }

        return decimal.TryParse(rawValue, out var parsedValue) ? Math.Max(0m, parsedValue) : null;
    }

    private decimal TransportSpeedKmh => Math.Max(1m, Configuration.GetValue<decimal?>("MovementSpeeds:TransportKmh") ?? 60m);

    private string GetDeliveryTimeLabel(PlayerTrade trade)
    {
        var buyer = AppState.MyPlayer;
        var seller = trade.FromPlayers;
        var distanceKm = CalculateDistanceKm(seller.LocationY, seller.LocationX, buyer.LocationY, buyer.LocationX);
        var travelTimeSeconds = Math.Max(60, (int)Math.Round((double)(distanceKm / Math.Max(1m, TransportSpeedKmh * _buyerTransportSpeedMultiplier) * 3600m)));
        return FormatDurationLabel(travelTimeSeconds);
    }

    private static decimal CalculateDistanceKm(decimal fromLat, decimal fromLng, decimal toLat, decimal toLng)
    {
        const decimal earthRadiusKm = 6371m;
        var dLat = ToRadians(toLat - fromLat);
        var dLon = ToRadians(toLng - fromLng);
        var lat1 = ToRadians(fromLat);
        var lat2 = ToRadians(toLat);

        var sinDlat = Math.Sin((double)dLat / 2d);
        var sinDlon = Math.Sin((double)dLon / 2d);
        var a = sinDlat * sinDlat + Math.Cos((double)lat1) * Math.Cos((double)lat2) * sinDlon * sinDlon;
        var c = 2d * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1d - a));
        return earthRadiusKm * (decimal)c;
    }

    private static decimal ToRadians(decimal degrees) => degrees * ((decimal)Math.PI / 180m);

    private string FormatDurationLabel(int totalSeconds)
    {
        var duration = TimeSpan.FromSeconds(Math.Max(60, totalSeconds));
        if (duration.TotalHours >= 24)
        {
            return string.Format(T["modals.trade.duration.daysHoursMinutes"], (int)duration.TotalDays, duration.Hours, duration.Minutes);
        }

        if (duration.TotalHours >= 1)
        {
            return string.Format(T["modals.trade.duration.hoursMinutes"], (int)duration.TotalHours, duration.Minutes);
        }

        return string.Format(T["modals.trade.duration.minutes"], Math.Max(1, duration.Minutes));
    }

