    private string GetResourceIconPath(string? resourceCode)
    {
        if (string.IsNullOrWhiteSpace(resourceCode))
        {
            return "/assets/icons/resources/money.png";
        }

        return TradeOfferResources.FirstOrDefault(r =>
                   string.Equals(r.Code.ToString(), resourceCode, StringComparison.OrdinalIgnoreCase))
               ?.IconPath
           ?? "/assets/icons/resources/money.png";
    }

    private string GetCountryDisplayName(Country? country)
    {
        if (country == null)
        {
            return string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(country.IsoCode2))
        {
            var localized = T[$"countries.name.{country.IsoCode2.ToUpperInvariant()}"];
            if (!string.IsNullOrWhiteSpace(localized) && !string.Equals(localized, $"countries.name.{country.IsoCode2.ToUpperInvariant()}", StringComparison.Ordinal))
            {
                return localized;
            }
        }

        return country.Name ?? string.Empty;
    }

    private static string? GetCountryFlagUrl(Country? country)
    {
        if (country == null)
        {
            return null;
        }

        if (!string.IsNullOrWhiteSpace(country.Flag))
        {
            return country.Flag;
        }

        return string.IsNullOrWhiteSpace(country.IsoCode2)
            ? null
            : $"/assets/flags/{country.IsoCode2.ToLowerInvariant()}.svg";
    }

