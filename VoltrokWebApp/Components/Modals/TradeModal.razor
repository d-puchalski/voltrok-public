    private Task HandleNewOfferQuantityInput(ChangeEventArgs args)
    {
        var ownedQuantity = _selectedResourceCode.HasValue
            ? (int)Math.Max(0m, Math.Floor(GetOwnedResourceAmount(_selectedResourceCode.Value)))
            : int.MaxValue;
        var parsedQuantity = int.TryParse(args.Value?.ToString(), out var quantity) ? quantity : 0;
        _newQuantity = Math.Clamp(parsedQuantity, 0, Math.Max(0, ownedQuantity));
        return Task.CompletedTask;
    }

    private Task HandleNewOfferPriceInput(ChangeEventArgs args)
    {
        var parsedPrice = decimal.TryParse(args.Value?.ToString(), out var price) ? price : 0m;
        _newPrice = Math.Max(0m, parsedPrice);
        return Task.CompletedTask;
    }

