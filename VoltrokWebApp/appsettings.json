{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/webserver-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "PriceIdBattlePassSeason": "",
    "PriceIdBattlePassMonth": "",
    "PriceIdBattlePass6Months": "",
    "PriceIdBattlePassYear": "",
    "PriceIdShieldSeason": "",
    "PriceIdShieldMonth": "",
    "PriceIdShield6Months": "",
    "PriceIdShieldYear": "",
    "PriceId24h": "price_1TK4AuEbSLIpAggsNXlSZnoq",
    "PriceIdMonth": "price_1TK4BtEbSLIpAggsMCf8Tt8C",
    "PriceIdYear": "price_1TK4CtEbSLIpAggsJZpPo4KB"
  },
  "MovementSpeeds": {
    "TransportKmh": 360
  }
}
